# Copy to deploy/.env (never committed) and fill in. Comments stay on their own
# lines. Generate each secret with the command above it; hex values keep URLs and
# quoting trouble-free.

# Public names; both need DNS records pointing at this server.
DOMAIN=phd.example.ac.in
FILES_DOMAIN=files.phd.example.ac.in
# https in production; http only for a local trial (DOMAIN=localhost, FILES_DOMAIN=files.localhost)
SCHEME=https
TZ=Asia/Kolkata

# DATA_DIR holds the database, files and certificates; BACKUP_DIR must be on a different disk.
DATA_DIR=/srv/anveshan
BACKUP_DIR=/mnt/backup/anveshan
BACKUP_KEEP_DAYS=30

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
CRON_SECRET=

# File store (Garage). Run deploy/garage-init.sh once after the first `up`.
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# space Garage may use on DATA_DIR's disk
GARAGE_CAPACITY=500GB
S3_BUCKET=anveshan
# echo GK$(openssl rand -hex 12)
S3_ACCESS_KEY_ID=
# openssl rand -hex 32
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=100

# Optional: each group is all-or-nothing; leave empty to keep it off.
# Email (the university's SMTP server)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# AI seminar to-dos: any OpenAI-compatible endpoint, e.g. Ollama on this server
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# University-email login; register <SCHEME>://<DOMAIN>/api/v1/auth/sso/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
SSO_ALLOWED_DOMAINS=
