# One origin for the app (web, /api, /export) and one for presigned file URLs.
# Automatic HTTPS when SCHEME=https; SCHEME=http only for a local trial.
# Caddy serves LISTEN_SCHEME, which is SCHEME except behind a tunnel that ends TLS
# (compose.tunnel.yml): there public URLs stay SCHEME and Caddy serves plain http.
# The client's own address, for the API's request limit (services/api/app/ratelimit.py).
# Directly on the internet it is the connecting address. Behind a tunnel (compose.tunnel.yml)
# every request arrives from cloudflared, so the address Cloudflare saw is taken from
# Cf-Connecting-Ip, trusted only from TRUSTED_PROXIES. Default: no proxy is trusted.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers Cf-Connecting-Ip
	}
}

{$LISTEN_SCHEME}://{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	handle /api/* {
		reverse_proxy api:8900 {
			# One address, not a list a client could start with a forged entry.
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle_path /export/* {
		reverse_proxy export:8902
	}
	handle {
		reverse_proxy web:3000
	}
}

# Browsers PUT/GET file bytes here with short-lived presigned URLs (SECURITY.md §6).
# Garage has no per-bucket CORS of its own here, so Caddy answers for it.
{$LISTEN_SCHEME}://{$FILES_DOMAIN} {
	header {
		Access-Control-Allow-Origin "{$SCHEME}://{$DOMAIN}"
		Access-Control-Expose-Headers ETag
		Vary Origin
		-Server
	}
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Methods "GET, HEAD, PUT"
		header Access-Control-Allow-Headers "Content-Type"
		header Access-Control-Max-Age 3600
		respond 204
	}
	handle {
		reverse_proxy garage:3900
	}
}

# Site-local extra blocks, e.g. an old name that redirects to DOMAIN; none by default
# (deploy/README.md, "Behind a Cloudflare Tunnel"). Files here are not committed.
import sites/*.caddy
